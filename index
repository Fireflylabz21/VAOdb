            repName: `Officer ${Math.floor(10 + Math.random() * 89)}`,
            state: stateKey,
            metro: info.metro,
            corridor: belt,
            mobile: randMobile,
            altMobile: randMobile,
            email: `official@domain.gov.in`,
            reraId: `REG-${Math.floor(10000 + Math.random() * 90000)}`,
            zoning: idx % 2 === 0 ? "Patta Transfer & FMB Records" : "DGPS & Aerial Drone Survey",
            parcelSize: "District Revenue Circle",
            verification: "RERA Verified"
          });
          added++;
        });
      });

      populateFilterDropdowns();
      renderDirectory();
      showToast(`Seeded ${added} records across belts! Total: ${landDatabase.length}`, "success");
    }

    function populateFilterDropdowns() {
      const stateSelect = document.getElementById('filterState');
      if (stateSelect) {
        const states = ['ALL', ...Object.keys(INDIA_SUBURBAN_STRUCTURE).sort()];
        stateSelect.innerHTML = states.map(s => `<option value="${s}">${s === 'ALL' ? 'All States & UTs' : s}</option>`).join('');
      }
      updateMetroDropdown();
    }

    function onStateFilterChange() {
      updateMetroDropdown();
      renderDirectory();
    }

    function updateMetroDropdown() {
      const selectedState = document.getElementById('filterState')?.value || 'ALL';
      const metroSelect = document.getElementById('filterMetro');
      if (!metroSelect) return;

      let metros = ['ALL'];
      if (selectedState !== 'ALL' && INDIA_SUBURBAN_STRUCTURE[selectedState]) {
        metros = ['ALL', INDIA_SUBURBAN_STRUCTURE[selectedState].metro];
      } else {
        metros = ['ALL', ...new Set(landDatabase.map(item => item.metro))].sort();
      }

      metroSelect.innerHTML = metros.map(m => `<option value="${m}">${m === 'ALL' ? 'All District Hubs' : m}</option>`).join('');
    }

    function onMetroFilterChange() {
      renderDirectory();
    }

    function resetFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('filterCategory').value = 'ALL';
      document.getElementById('filterState').value = 'ALL';
      populateFilterDropdowns();
      document.getElementById('filterZoning').value = 'ALL';
      document.getElementById('filterRera').value = 'ALL';
      renderDirectory();
      showToast("Reset all directory filters", "info");
    }

    function openAddModal() {
      document.getElementById('modalTitle').innerHTML = `<i data-lucide="user-plus" class="w-4 h-4 text-emerald-400"></i> <span>Add New Officer / Surveyor / Agent</span>`;
      document.getElementById('landForm').reset();
      document.getElementById('editLandId').value = '';
      document.getElementById('landModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeAddModal() {
      document.getElementById('landModal').classList.add('hidden');
    }

    function editLandRecord(id) {
      const item = landDatabase.find(d => d.id === id);
      if (!item) return;

      document.getElementById('modalTitle').innerHTML = `<i data-lucide="edit-3" class="w-4 h-4 text-emerald-400"></i> <span>Edit: ${escapeHtml(item.firmName)}</span>`;
      document.getElementById('editLandId').value = item.id;
      document.getElementById('inputState').value = item.state;
      document.getElementById('inputMetro').value = item.metro;
      document.getElementById('inputCorridor').value = item.corridor;
      document.getElementById('inputCategory').value = item.category || 'Village Administrative Officer (VAO)';
      document.getElementById('inputFirm').value = item.firmName;
      document.getElementById('inputRepName').value = item.repName;
      document.getElementById('inputRera').value = item.reraId || '';
      document.getElementById('inputMobile').value = item.mobile;
      document.getElementById('inputAltMobile').value = item.altMobile || '';
      document.getElementById('inputVerification').value = item.verification || 'RERA Verified';
      document.getElementById('inputZoning').value = item.zoning || '';
      document.getElementById('inputParcelSize').value = item.parcelSize || '';
      document.getElementById('inputEmail').value = item.email || '';

      document.getElementById('landModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function saveLandRecord(event) {
      event.preventDefault();
      const editId = document.getElementById('editLandId').value;

      const newRecord = {
        id: editId || `DEV-${Date.now()}`,
        state: document.getElementById('inputState').value.trim(),
        metro: document.getElementById('inputMetro').value.trim(),
        corridor: document.getElementById('inputCorridor').value.trim(),
        category: document.getElementById('inputCategory').value,
        firmName: document.getElementById('inputFirm').value.trim(),
        repName: document.getElementById('inputRepName').value.trim(),
        reraId: document.getElementById('inputRera').value.trim() || 'Govt Registered',
        mobile: document.getElementById('inputMobile').value.trim(),
        altMobile: document.getElementById('inputAltMobile').value.trim(),
        verification: document.getElementById('inputVerification').value,
        zoning: document.getElementById('inputZoning').value.trim() || 'Patta Transfer / DGPS',
        parcelSize: document.getElementById('inputParcelSize').value.trim() || 'Revenue Division',
        email: document.getElementById('inputEmail').value.trim()
      };

      if (editId) {
        const index = landDatabase.findIndex(d => d.id === editId);
        if (index !== -1) landDatabase[index] = newRecord;
        showToast(`Updated ${newRecord.firmName}`, "success");
      } else {
        landDatabase.unshift(newRecord);
        showToast(`Added ${newRecord.firmName}`, "success");
      }

      closeAddModal();
      populateFilterDropdowns();
      renderDirectory();
    }

    function deleteLandRecord(id) {
      const item = landDatabase.find(d => d.id === id);
      if (!item) return;

      showConfirmModal(
        "Delete Record",
        `Remove "${item.firmName}" (${item.corridor}) from directory?`,
        () => {
          landDatabase = landDatabase.filter(d => d.id !== id);
          populateFilterDropdowns();
          renderDirectory();
          showToast(`Deleted ${item.firmName}`, "info");
        }
      );
    }

    function openSyncGuideModal() {
      document.getElementById('syncGuideModal').classList.remove('hidden');
    }
    function closeSyncGuideModal() {
      document.getElementById('syncGuideModal').classList.add('hidden');
    }

    function openBroadcastModal() {
      const activeData = getFilteredData();
      document.getElementById('broadcastRecipientCount').innerText = activeData.length;
      document.getElementById('broadcastModal').classList.remove('hidden');
    }
    function closeBroadcastModal() {
      document.getElementById('broadcastModal').classList.add('hidden');
    }

    function applyBroadcastTemplate() {
      const val = document.getElementById('templateSelect').value;
      const txt = document.getElementById('broadcastText');

      if (val === 'agro') {
        txt.value = "AGRO LAND REQUIREMENT: Seeking 25 to 100 Acres clear-title farmland with borewell water connection & fencing in Pollachi/Hosur/Tenkasi belt.";
      } else if (val === 'survey') {
        txt.value = "DGPS SURVEY REQUEST: Seeking licensed surveyor for 30-Acre layout subdivision and boundary mapping in suburban corridor.";
      } else if (val === 'jv') {
        txt.value = "JOINT VENTURE (JV) INQUIRY: Seeking 10 to 50 Acres of clear-title land for DTCP / RERA approved plotted residential layout.";
      } else {
        txt.value = "";
      }
    }

    function triggerBroadcastDispatch() {
      const brokers = getFilteredData();
      const numbers = brokers.map(d => d.mobile).filter(Boolean);

      if (numbers.length === 0) {
        showToast("No active numbers in filter.", "warning");
        return;
      }

      navigator.clipboard.writeText(numbers.join(', ')).then(() => {
        showToast(`Copied ${numbers.length} mobile numbers to Clipboard!`, "success");
        closeBroadcastModal();
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Initialize Application
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      populateFilterDropdowns();
      renderDirectory();
      fetchFromGoogleSheet(true);
    });
  </script>
</body>
</html>
