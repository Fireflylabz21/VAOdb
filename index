    const GOOGLE_SHEET_EDIT_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/edit`;

    function openGoogleSheet() {
      window.open(GOOGLE_SHEET_EDIT_URL, '_blank');
      showToast("Opening Google Sheet database in new tab...", "info");
    }

    async function fetchFromGoogleSheet(silent = false) {
      try {
        if (!silent) showToast("Syncing with Google Sheet ID...", "info");
        const response = await fetch(GOOGLE_SHEET_CSV_URL);
        if (!response.ok) throw new Error("Could not fetch CSV stream from Google Sheet ID");
        const csvText = await response.text();
        const parsedCount = parseAndMergeCSVText(csvText);
        if (parsedCount > 0) {
          showToast(`Synced ${parsedCount} new records from Google Sheet ID!`, "success");
        } else if (!silent) {
          showToast("Sheet synced! All records up to date.", "info");
        }
      } catch (err) {
        console.warn("Google Sheet Fetch Notice:", err);
        if (!silent) {
          showToast("Opening active Sheet in new tab for direct access...", "warning");
          openGoogleSheet();
        }
      }
    }

    function parseAndMergeCSVText(text) {
      const lines = text.split(/\r\n|\n/);
      let addedCount = 0;

      for (let i = 1; i < lines.length; i++) {
        if (!lines[i].trim()) continue;
        const cols = parseCSVLine(lines[i]);
        if (cols.length >= 5) {
          const firmName = cols[4] || cols[0] || 'Official Office';
          const mobile = cols[6] || cols[5] || '';
          
          const exists = landDatabase.some(item => 
            (item.firmName && item.firmName.toLowerCase() === firmName.toLowerCase()) && 
            (item.mobile === mobile)
          );

          if (!exists) {
            landDatabase.unshift({
              id: `DEV-GS-${Date.now()}-${i}`,
              state: cols[0] || 'Tamil Nadu',
              metro: cols[1] || 'Chennai Outer',
              corridor: cols[2] || 'Suburban Corridor',
              category: cols[3] || 'Village Administrative Officer (VAO)',
              firmName: firmName,
              repName: cols[5] || cols[4] || 'Official Representative',
              mobile: mobile,
              altMobile: cols[7] || cols[6] || '',
              email: cols[8] || '',
              zoning: cols[9] || 'Patta Transfer / Land Records',
              parcelSize: cols[10] || 'Revenue Circle',
              reraId: cols[11] || 'Registered',
              verification: cols[12] || 'RERA Verified'
            });
            addedCount++;
          }
        }
      }

      if (addedCount > 0) {
        populateFilterDropdowns();
        renderDirectory();
      }
      return addedCount;
    }

    function parseCSVLine(line) {
      const result = [];
      let current = '';
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const char = line[i];
        if (char === '"') {
          inQuotes = !inQuotes;
        } else if (char === ',' && !inQuotes) {
          result.push(current.trim().replace(/^"|"$/g, ''));
          current = '';
        } else {
          current += char;
        }
      }
      result.push(current.trim().replace(/^"|"$/g, ''));
      return result;
