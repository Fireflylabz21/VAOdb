<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Landcalci db - Pan-India Land Developers, VAOs, Surveyors & Agro Directory</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            landDark: '#0f172a',
            landEmerald: '#059669',
            landGold: '#d97706',
            landNavy: '#1e293b',
            landAccent: '#0284c7'
          }
        }
      }
    }
  </script>
  
  <style>
    /* Mobile Touch Optimizations */
    -webkit-tap-highlight-color: transparent;
    
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }
    .animate-pulseGlow {
      animation: pulseGlow 2.5s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800 min-h-full pb-20 md:pb-6 flex flex-col relative antialiased selection:bg-emerald-500 selection:text-white">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-3 left-3 right-3 sm:right-4 sm:left-auto sm:w-80 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- Custom Confirm Action Modal -->
  <div id="customConfirmModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl sm:rounded-xl shadow-2xl max-w-md w-full p-5 sm:p-6 space-y-4 border border-slate-200 animate-in fade-in zoom-in duration-150">
      <div class="flex items-center space-x-3 text-amber-600">
        <div class="p-2 bg-amber-50 rounded-lg">
          <i data-lucide="alert-triangle" class="w-6 h-6 shrink-0"></i>
        </div>
        <h3 id="confirmTitle" class="font-bold text-slate-900 text-base">Confirm Action</h3>
      </div>
      <p id="confirmMessage" class="text-xs text-slate-600 leading-relaxed">Are you sure you want to perform this directory management action?</p>
      <div class="flex justify-end space-x-2 pt-2 border-t border-slate-100">
        <button id="confirmCancelBtn" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition active:scale-95">Cancel</button>
        <button id="confirmOkBtn" class="px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-semibold transition shadow-sm active:scale-95">Proceed</button>
      </div>
    </div>
  </div>

  <!-- Top Luxury Bar -->
  <div class="h-1.5 w-full bg-gradient-to-r from-emerald-600 via-amber-500 to-sky-600 sticky top-0 z-40"></div>

  <header class="bg-slate-900 text-white shadow-lg sticky top-1.5 z-30 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-2">
      
      <!-- Brand & Mobile Title -->
      <div class="flex items-center space-x-2.5 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center shadow-md text-white font-bold shrink-0">
          <i data-lucide="map" class="w-5 h-5 text-amber-300"></i>
        </div>
        <div class="min-w-0">
          <div class="flex items-center space-x-1.5">
            <h1 class="text-xs sm:text-base font-bold tracking-tight text-white truncate">Landcalci db</h1>
            <span class="hidden lg:inline-block bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-0.5 rounded font-semibold border border-emerald-500/30">OFFICIAL CADRE & AGENTS</span>
          </div>
          <p class="text-[10px] sm:text-xs text-slate-300 truncate">VAOs, DGPS Surveyors, Agro Agents, Developers & Tahsildars</p>
        </div>
      </div>

      <!-- Desktop Quick Actions Bar -->
      <div class="hidden md:flex items-center space-x-2 text-xs">
        <button onclick="openAiMarketModal()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-semibold px-3 py-2 rounded-xl transition flex items-center space-x-1.5 shadow-md border border-emerald-400/30 animate-pulseGlow active:scale-95">
          <i data-lucide="sparkles" class="w-4 h-4 text-amber-300"></i>
          <span>AI Market Search</span>
        </button>
        <button onclick="openSyncGuideModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium px-3 py-2 rounded-xl transition flex items-center space-x-1 border border-slate-700 active:scale-95">
          <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-400"></i>
          <span>Sheets Guide</span>
        </button>
      </div>

      <!-- Mobile Quick Menu Trigger Button -->
      <button onclick="toggleMobileActionsMenu()" class="md:hidden p-2 text-slate-300 hover:text-white bg-slate-800 rounded-lg border border-slate-700 active:bg-slate-700">
        <i data-lucide="more-vertical" class="w-5 h-5"></i>
      </button>

    </div>
  </header>

  <!-- Mobile Actions Drawer Menu -->
  <div id="mobileActionsDrawer" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 hidden transition-opacity flex flex-col justify-end md:hidden">
    <div class="bg-white rounded-t-2xl p-5 space-y-3 border-t border-slate-200 max-h-[80vh] overflow-y-auto animate-in slide-in-from-bottom duration-200">
      <div class="flex items-center justify-between border-b pb-2">
        <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
          <i data-lucide="sliders" class="w-4 h-4 text-emerald-600"></i> Quick Portal Tools
        </h3>
        <button onclick="toggleMobileActionsMenu()" class="p-1 text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-2 text-xs pt-1">
        <button onclick="toggleMobileActionsMenu(); fetchFromGoogleSheet();" class="p-3 bg-emerald-100 text-emerald-900 rounded-xl font-bold flex flex-col items-center justify-center text-center space-y-1.5 border border-emerald-300 active:scale-95">
          <i data-lucide="refresh-cw" class="w-5 h-5 text-emerald-700"></i>
          <span>Sync Google Sheet</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); openGoogleSheet();" class="p-3 bg-slate-100 text-slate-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-slate-300 active:scale-95">
          <i data-lucide="external-link" class="w-5 h-5 text-slate-700"></i>
          <span>Open Sheet ID</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); openAiMarketModal();" class="p-3 bg-emerald-50 text-emerald-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-emerald-200 active:scale-95">
          <i data-lucide="sparkles" class="w-5 h-5 text-emerald-600"></i>
          <span>Grounded AI Query</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); seedAllIndiaLandData();" class="p-3 bg-amber-50 text-amber-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-amber-200 active:scale-95">
          <i data-lucide="globe" class="w-5 h-5 text-amber-600"></i>
          <span>Auto-Seed All Belts</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); exportToCSV();" class="p-3 bg-slate-50 text-slate-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-slate-200 active:scale-95">
          <i data-lucide="download" class="w-5 h-5 text-slate-600"></i>
          <span>Export CSV</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); copyForGoogleSheets();" class="p-3 bg-blue-50 text-blue-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-blue-200 active:scale-95">
          <i data-lucide="copy" class="w-5 h-5 text-blue-600"></i>
          <span>Copy for Sheets</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); openBroadcastModal();" class="p-3 bg-indigo-50 text-indigo-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-indigo-200 active:scale-95">
          <i data-lucide="send" class="w-5 h-5 text-indigo-600"></i>
          <span>Broadcast Lead</span>
        </button>

        <button onclick="toggleMobileActionsMenu(); triggerCSVImport();" class="p-3 bg-slate-50 text-slate-800 rounded-xl font-semibold flex flex-col items-center justify-center text-center space-y-1.5 border border-slate-200 active:scale-95">
          <i data-lucide="upload" class="w-5 h-5 text-slate-600"></i>
          <span>Import CSV File</span>
        </button>
      </div>

      <div class="pt-2 border-t">
        <button onclick="toggleMobileActionsMenu(); openAddModal();" class="w-full py-3 bg-slate-900 text-white rounded-xl font-semibold text-xs flex items-center justify-center space-x-2 shadow">
          <i data-lucide="user-plus" class="w-4 h-4 text-emerald-400"></i>
          <span>Add New Officer / Surveyor / Agent</span>
        </button>
      </div>
    </div>
  </div>

  <main class="flex-grow max-w-7xl w-full mx-auto px-3.5 sm:px-6 lg:px-8 py-4 space-y-4">

    <!-- Metrics Cards Grid (Responsive 2x2 on Mobile, 4x1 on Desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4">
      <div class="bg-white p-3 sm:p-4 rounded-xl sm:rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider">Active Entities</p>
          <div class="p-1.5 sm:p-2.5 bg-emerald-50 text-emerald-600 rounded-lg sm:rounded-xl">
            <i data-lucide="users" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          </div>
        </div>
        <div class="mt-2">
          <h3 id="statTotalBrokers" class="text-xl sm:text-2xl font-black text-slate-900">0</h3>
          <p class="text-[9px] sm:text-[10px] text-emerald-700 font-medium truncate mt-0.5">VAOs, Surveyors & Agents</p>
        </div>
      </div>

      <div class="bg-white p-3 sm:p-4 rounded-xl sm:rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider">Licensed Cadre</p>
          <div class="p-1.5 sm:p-2.5 bg-blue-50 text-blue-600 rounded-lg sm:rounded-xl">
            <i data-lucide="shield-check" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          </div>
        </div>
        <div class="mt-2">
          <h3 id="statReraCount" class="text-xl sm:text-2xl font-black text-blue-600">0</h3>
          <p class="text-[9px] sm:text-[10px] text-blue-700 font-medium truncate mt-0.5">RERA / Govt Cadre</p>
        </div>
      </div>

      <div class="bg-white p-3 sm:p-4 rounded-xl sm:rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider">Acreage Scope</p>
          <div class="p-1.5 sm:p-2.5 bg-amber-50 text-amber-600 rounded-lg sm:rounded-xl">
            <i data-lucide="layers" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          </div>
        </div>
        <div class="mt-2">
          <h3 id="statTotalAcres" class="text-xl sm:text-2xl font-black text-amber-600">15,000+ Ac</h3>
          <p class="text-[9px] sm:text-[10px] text-amber-700 font-medium truncate mt-0.5">Agri & Survey Mapping</p>
        </div>
      </div>

      <div class="bg-white p-3 sm:p-4 rounded-xl sm:rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider">District Belts</p>
          <div class="p-1.5 sm:p-2.5 bg-purple-50 text-purple-600 rounded-lg sm:rounded-xl">
            <i data-lucide="navigation" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          </div>
        </div>
        <div class="mt-2">
          <h3 id="statCorridors" class="text-xl sm:text-2xl font-black text-purple-600">0</h3>
          <p class="text-[9px] sm:text-[10px] text-slate-400 font-medium truncate mt-0.5">Suburban & Agro Zones</p>
        </div>
      </div>
    </div>

    <!-- Controls Box -->
    <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl shadow-sm border border-slate-200 space-y-3">
      
      <!-- Search Row & Desktop Action Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5 sm:gap-4">
        
        <!-- Search Input -->
        <div class="relative flex-1">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 transform -translate-y-1/2"></i>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search VAO, Surveyor, Agent, Village, Mobile..." 
            class="w-full pl-9 pr-8 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition"
            oninput="renderDirectory()"
          >
          <button onclick="document.getElementById('searchInput').value=''; renderDirectory();" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1">
            <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
          </button>
        </div>

        <!-- Filter Drawer Toggle (Mobile) -->
        <div class="flex items-center justify-between gap-2 md:hidden">
          <button onclick="toggleMobileFilterPanel()" class="flex-1 py-2 px-3 bg-slate-100 border border-slate-300 text-slate-700 rounded-xl text-xs font-semibold flex items-center justify-center space-x-1.5 active:bg-slate-200">
            <i data-lucide="filter" class="w-3.5 h-3.5 text-emerald-600"></i>
            <span>Filters & Categories</span>
            <i data-lucide="chevron-down" id="filterChevron" class="w-3.5 h-3.5 transition-transform"></i>
          </button>
          
          <button onclick="openAddModal()" class="py-2 px-3 bg-slate-900 text-white rounded-xl text-xs font-semibold flex items-center space-x-1 shadow active:scale-95">
            <i data-lucide="user-plus" class="w-3.5 h-3.5 text-emerald-400"></i>
            <span>Add</span>
          </button>
        </div>

        <!-- Desktop Action Buttons -->
        <div class="hidden md:flex flex-wrap items-center gap-2">
          <button onclick="fetchFromGoogleSheet()" class="px-3 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="refresh-cw" class="w-4 h-4 text-emerald-300"></i>
            <span>Fetch from Sheet ID</span>
          </button>

          <button onclick="openAiMarketModal()" class="px-3 py-2 bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="globe" class="w-4 h-4 text-amber-300"></i>
            <span>Live Grounded DB</span>
          </button>

          <button onclick="seedAllIndiaLandData()" class="px-3 py-2 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            <span>Auto-Seed Belts</span>
          </button>

          <button onclick="openAddModal()" class="px-3 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="user-plus" class="w-4 h-4 text-emerald-400"></i>
            <span>Add Entity</span>
          </button>

          <button onclick="triggerCSVImport()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 active:scale-95">
            <i data-lucide="upload" class="w-4 h-4 text-slate-600"></i>
            <span>Import CSV</span>
          </button>
          <input type="file" id="csvFileInput" accept=".csv" class="hidden" onchange="handleCSVImport(event)">

          <button onclick="exportToCSV()" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>Export CSV</span>
          </button>

          <button onclick="copyForGoogleSheets()" class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="copy" class="w-4 h-4"></i>
            <span>Copy Sheets</span>
          </button>

          <button onclick="openBroadcastModal()" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition flex items-center space-x-1.5 shadow-sm active:scale-95">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span>Broadcast</span>
          </button>
        </div>
      </div>

      <!-- Filters Section (Collapsible on Mobile, Expanded on Desktop) -->
      <div id="filterPanel" class="hidden md:block pt-3 border-t border-slate-100">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2 text-xs">
          
          <!-- Category Filter -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Entity Role / Cadre</label>
            <select id="filterCategory" onchange="renderDirectory()" class="w-full bg-emerald-50 border border-emerald-300 rounded-lg p-2 text-emerald-900 font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500">
              <option value="ALL">All Officers & Roles</option>
              <option value="Village Administrative Officer (VAO)">Village Administrative Officer (VAO)</option>
              <option value="Tahsildar / Revenue Inspector (RI)">Tahsildar / Revenue Inspector (RI)</option>
              <option value="Land Surveyor & Cadastral Consultant">Land Surveyor & DGPS Consultant</option>
              <option value="Farmhouse & Agro Agent">Farmhouse & Agro Agent</option>
              <option value="Land Developer">Land Developer & Promoter</option>
              <option value="Channel Partner">Channel Partner / Broker</option>
            </select>
          </div>

          <!-- State Filter -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">State / UT</label>
            <select id="filterState" onchange="onStateFilterChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
              <option value="ALL">All States & UTs</option>
            </select>
          </div>

          <!-- Metro / District Filter -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">District / Hub</label>
            <select id="filterMetro" onchange="onMetroFilterChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
              <option value="ALL">All District Hubs</option>
            </select>
          </div>

          <!-- Zoning Filter -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Specialization</label>
            <select id="filterZoning" onchange="renderDirectory()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
              <option value="ALL">All Specializations</option>
              <option value="DGPS">DGPS & Drone Survey</option>
              <option value="Agri Land / Farmhouse">Agri Land / Organic Farm</option>
              <option value="DTCP/Layout">DTCP / CMDA Approved</option>
              <option value="HMDA/CMDA/BDA">HMDA / BDA / BIAPPA Approved</option>
            </select>
          </div>

          <!-- Verification Filter -->
          <div class="flex items-end justify-between space-x-2">
            <div class="flex-1">
              <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Verification</label>
              <select id="filterRera" onchange="renderDirectory()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                <option value="ALL">All Verifications</option>
                <option value="RERA Verified">RERA / Licensed Cadre</option>
                <option value="Direct Mandate">Direct Owner Mandate</option>
              </select>
            </div>
            
            <button onclick="resetFilters()" class="p-2 text-slate-500 hover:text-emerald-700 hover:bg-slate-100 rounded-lg flex items-center justify-center font-medium active:scale-95 border border-slate-200" title="Reset Filters">
              <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            </button>
          </div>

        </div>
      </div>
    </div>

    <!-- Directory Listing Section -->
    <div class="bg-white rounded-xl sm:rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      
      <!-- Top Record Counter & Mobile Header -->
      <div class="bg-slate-900 text-slate-200 px-4 py-2.5 flex items-center justify-between text-xs border-b border-slate-800">
        <div class="font-semibold flex items-center space-x-2">
          <i data-lucide="database" class="w-4 h-4 text-emerald-400"></i>
          <span>Showing <span id="recordCount" class="text-amber-300 font-mono font-bold">0</span> verified records</span>
        </div>
        <span class="text-[10px] text-slate-400 hidden sm:inline">Official Pan-India Cadre Directory Schema</span>
      </div>

      <!-- Mobile Card List View (< 768px) -->
