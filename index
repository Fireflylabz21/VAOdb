    function getFilteredData() {
      const search = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const category = document.getElementById('filterCategory')?.value || 'ALL';
      const state = document.getElementById('filterState')?.value || 'ALL';
      const metro = document.getElementById('filterMetro')?.value || 'ALL';
      const zoning = document.getElementById('filterZoning')?.value || 'ALL';
      const rera = document.getElementById('filterRera')?.value || 'ALL';

      return landDatabase.filter(item => {
        if (search) {
          const matchSearch = (
            (item.firmName && item.firmName.toLowerCase().includes(search)) ||
            (item.repName && item.repName.toLowerCase().includes(search)) ||
            (item.category && item.category.toLowerCase().includes(search)) ||
            (item.corridor && item.corridor.toLowerCase().includes(search)) ||
            (item.metro && item.metro.toLowerCase().includes(search)) ||
            (item.state && item.state.toLowerCase().includes(search)) ||
            (item.mobile && item.mobile.includes(search)) ||
            (item.altMobile && item.altMobile.includes(search)) ||
            (item.reraId && item.reraId.toLowerCase().includes(search)) ||
            (item.zoning && item.zoning.toLowerCase().includes(search))
          );
          if (!matchSearch) return false;
        }

        if (category !== 'ALL' && item.category !== category) return false;
        if (state !== 'ALL' && item.state !== state) return false;
        if (metro !== 'ALL' && item.metro !== metro) return false;

        if (zoning !== 'ALL') {
          const zLow = (item.zoning || '').toLowerCase();
          if (zoning === 'DGPS' && !zLow.includes('dgps') && !zLow.includes('topo') && !zLow.includes('drone')) return false;
          if (zoning === 'Agri Land / Farmhouse' && !zLow.includes('agri') && !zLow.includes('farm') && !zLow.includes('coconut') && !zLow.includes('patta')) return false;
          if (zoning === 'DTCP/Layout' && !zLow.includes('dtcp') && !zLow.includes('layout')) return false;
          if (zoning === 'HMDA/CMDA/BDA' && !zLow.includes('hmda') && !zLow.includes('cmda') && !zLow.includes('bda')) return false;
        }

        if (rera !== 'ALL' && item.verification !== rera) return false;

        return true;
      });
    }

